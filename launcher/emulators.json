      "exe": ["kyty_emulator.exe"],
      "args": ["{game}"]
    },
    {
      "id": "rpcs3",
      "name": "RPCS3",
      "dir": "rpcs3",
      "systems": ["ps3"],
      "exe": ["rpcs3.exe"],
      "args": ["{game}"]
    },
    {
      "id": "pcsx2",
      "name": "PCSX2",
      "dir": "pcsx2",
      "systems": ["ps2"],
      "exe": ["pcsx2-qt.exe"],
      "args": ["-batch", "--", "{game}"]
    },
    {
      "id": "duckstation",
      "name": "DuckStation",
      "dir": "duckstation",
      "systems": ["ps1"],
      "exe": ["duckstation-qt-x64-ReleaseLTCG.exe", "duckstation-qt.exe"],
